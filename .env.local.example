# お問い合わせフォーム送信用 (https://resend.com でAPIキーを発行)
RESEND_API_KEY=

# お問い合わせを受け取りたい宛先メールアドレス
# 独自ドメイン未認証のサンドボックスモードでは、Resendアカウント登録時と
# 同じメールアドレスしか受信できないので注意 (vercel.app等の無料ドメイン運用時はこれでOK)
CONTACT_TO_EMAIL=

# 送信元として使うメールアドレス
# 独自ドメインをResendに認証していない場合は onboarding@resend.dev のままでOK
# (vercel.appのような無料ドメインは外部ドメイン認証ができないため、通常はこのままでよい)
CONTACT_FROM_EMAIL=onboarding@resend.dev

# サイトの本番URL (sitemap.xml生成に使用)
NEXT_PUBLIC_SITE_URL=https://example.com
